# =============================================================================
# Auto-Company — runtime.env TEMPLATE
# =============================================================================
# The live loop reads runtime overrides from  logs/runtime.env  (a persistent
# volume, NOT committed — logs/ is gitignored). This .example is the tracked
# reference so a fresh clone + deploy knows every knob and secret the loop uses.
#
# On a fresh deploy, provide these values one of two ways:
#   1) copy this file to  logs/runtime.env  and fill it in, OR
#   2) set them as Coolify container env vars (PID1 env; e.g. CONTEXT7_API_KEY
#      is provided this way today).
# Either layer feeds the loop's environment; runtime.env wins as an override.
#
# Format: literal  KEY=value  per line (docker-entrypoint.sh parses it directly,
# never `. source`s it — so values with shell-special chars like `|` are safe).
# NEVER commit real secret values. The cockpit "Settings — Runtime Config" panel
# only edits the NON-SECRET knobs below and preserves everything else.
# =============================================================================

# ------------------------------------------------------------------
# NON-SECRET operator knobs (editable in the cockpit Settings panel)
# Values below are the current tuned defaults — safe to ship as-is.
# ------------------------------------------------------------------

# Primary engine: claude | codex  (blank = claude)
ENGINE=claude

# Router alternation: 1 = alternate Claude<->Codex when both have headroom
ROUTER_ALTERNATE=1

# Tier ladder: 1 = round-robin model/effort within a MIN..MAX range (saves tokens)
ROUTER_TIER_LADDER=1
# Claude model ladder, cheapest first (comma-sep)
CLAUDE_TIER_LADDER=claude-haiku-4-5-20251001,claude-sonnet-5
# Codex effort ladder, cheapest first (comma-sep)
CODEX_TIER_LADDER=low,medium

# Claude model override (blank = engine default)
MODEL=
# Claude reasoning effort: low | medium | high  (blank = default)
CLAUDE_EFFORT=
# Codex reasoning effort: low | medium | high  (blank = codex default; operator cap = high)
CODEX_EFFORT=

# Seconds between loop cycles
LOOP_INTERVAL=900
# Claude 5h rolling-window budget in USD (blank = no cap)
WINDOW_BUDGET_USD=
# Codex cycles per window (blank = unmetered)
CODEX_WINDOW_LIMIT=
# Pause when budget hit and Codex unavailable (seconds)
BUDGET_PAUSE_SECONDS=

# ------------------------------------------------------------------
# SECRETS / credentials — fill on deploy, NEVER commit real values.
# (Left blank/commented here on purpose. Store via Keychain->runtime.env
#  or as Coolify env vars.)
# ------------------------------------------------------------------

# LLM engine auth
# CLAUDE_CODE_OAUTH_TOKEN=      # headless Claude token (`claude setup-token`)
# CODEX_AUTH_B64=              # base64 of Codex auth.json (optional Codex fallback)

# Integrations the loop reads/writes (headless-safe, via .mcp.json ${VAR})
# CONTEXT7_API_KEY=            # Context7 docs MCP (today provided via Coolify env)
# AIRTABLE_API_KEY=           # Airtable PAT, base-scoped to appPLc31jSlgulX3D (APP-230)
# LINEAR_API_KEY=             # Linear personal API key, team APP (APP-230)

# Operator channel (Telegram per-cycle ping — APP-227)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Comms / outreach (Twilio Email+SMS+WhatsApp+Voice — APP-211/212/213)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_SID=
# TWILIO_API_SECRET=

# Deploy / self-redeploy (Coolify — see redeploy runbook)
# COOLIFY_URL=https://app.coolify.io
# COOLIFY_APP_UUID=
# COOLIFY_DEPLOY_TOKEN=        # Coolify token format is  id|secret  (the `|` is why
#                             #  the entrypoint parses literally, never `. source`)

# Company git identity (for the company's own deploys, separate from the operator)
# GH_TOKEN=
# COMPANY_GIT_NAME=
# COMPANY_GIT_EMAIL=
